{
  "compilerOptions": {
    /* Target & Environment */
    "target": "es2022",                  // Baseline for modern LTS Node.js
    "module": "nodenext",                // Enforces native Node.js ESM or CJS
    "moduleResolution": "nodenext",      // Matches native Node.js resolution rules
    "lib": ["es2022"],                   // Keeps backend clean of DOM types

    /* Build Output */
    "rootDir": "./src",                  // Source file location
    "outDir": "./dist",                  // Where production .js files are created
    "sourceMap": true,                   // Essential for production error stack traces
    "declaration": true,                 // Useful for microservices or monorepos

    /* Strictness & Safety */
    "strict": true,                      // Industry default requirement
    "noUncheckedIndexedAccess": true,    // Highly recommended for safe Request parsing
    "skipLibCheck": true,                // Prevents third-party node_modules type errors

    /* Modern Interop Rules */
    "esModuleInterop": true,             // Ensures smooth imports from legacy Express CJS middleware
    "forceConsistentCasingInFileNames": true, // Prevents cross-OS build crashes
    "verbatimModuleSyntax": true         // Forces explicit 'import type' for cleaner bundles
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist"]
}
